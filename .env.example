# ====================================================================
# HƯỚNG DẪN CẤU HÌNH XÁC THỰC SUPABASE ĐỂ DEPLOY LOVECARD 20/10 (TÙY CHỌN)
# ====================================================================
# Web app hỗ trợ 2 chế độ:
# 1. Chế độ Mặc Định (Dev/Preview): Tự động lưu tài khoản vào Local Storage
#    mà không cần bất kỳ cấu hình hay tài khoản bên ngoài nào.
# 2. Chế độ Production Cloud (Khi Deploy Vercel / Netlify):
#    Kết nối trực tiếp Supabase Auth & Google OAuth bằng cách điền 2 biến dưới:

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Các bước thiết lập Supabase (Miễn phí 100%):
# 1. Tạo project tại https://supabase.com
# 2. Copy "Project URL" và "anon public key" từ Settings -> API
# 3. Để bật đăng nhập Google:
#    - Vào Authentication -> Providers -> Google -> Bật ON
#    - Thêm Client ID và Secret từ Google Cloud Console
#    - Redirect URL là: https://your-project.supabase.co/auth/v1/callback
